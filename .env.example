# Project Kestrel - configuration template.
#
# Copy to .env and fill in real values:   cp .env.example .env
# .env is ignored by Git. Never commit the filled-in version, and never paste
# a real value into a .py or .ipynb file.
#
# Every name below is read by the code. Verify with:
#   grep -rn 'getenv(' src scripts

# --- Database -------------------------------------------------------------
# Supabase -> Connect -> Session pooler (port 5432). Port 6543 is the
# transaction pooler: it cannot run COPY or prepared statements, so the
# dataset generator is far slower against it.
# URL-encode special characters in the password: @ -> %40, : -> %3A, / -> %2F
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"

# --- LLM and embeddings ---------------------------------------------------
# Read by the agent (chat model) and the REST tier (policy embeddings).
# Falls back to GEMINI_API_KEY.
GOOGLE_API_KEY="your-gemini-api-key"
# Pin the chat model before the final evaluation (Section 5.7); the alias
# "gemini-flash-latest" can change underneath you.
GEMINI_MODEL="gemini-flash-latest"
# Reasoning depth for Gemini 3 models: minimal, low, medium or high. "low"
# keeps each step of the tool loop fast; leave empty for the model default.
GEMINI_THINKING_LEVEL="low"
# Attempts per Gemini call (1 = no retry) and per-call timeout in seconds.
# The SDK default of 6 attempts let a quota error stall a chat turn > 45 s.
GEMINI_MAX_ATTEMPTS="2"
GEMINI_TIMEOUT_S="20"
EMBEDDING_MODEL="gemini-embedding-001"
# Similarity threshold tau for the policy scope guard (FR-05). Start at 0.75;
# replace with the value printed by scripts/evaluation/evaluate_retrieval.py.
POLICY_TAU="0.75"

# --- Session authentication ----------------------------------------------
# auth.py reads SESSION_SECRET. If it is unset the API still starts but
# generates a throwaway secret per process, so every bearer token is
# invalidated on restart and it prints a [WARN] on boot.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET="generate-your-own-do-not-use-this-placeholder"

# --- Staff case queue (FR-09) ---------------------------------------------
# Shared key sent as the X-Staff-Key header. Unset = staff endpoints disabled.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
STAFF_API_KEY="generate-your-own-staff-key"

# Shared by the REST tier and the agent service: the agent sends it as
# X-Agent-Key to save the assistant's turns of a conversation; a passenger
# token alone can save only the passenger's own turns. Unset: .	asks.ps1
# start generates one for that run and gives it to both services.
AGENT_HISTORY_KEY="generate-your-own-agent-history-key"

# --- Social sign-in (Supabase Auth) ---------------------------------------
# POST /api/auth/account checks a Supabase access token (Google, or an
# emailed one-time code) by calling GET {SUPABASE_URL}/auth/v1/user.
# Supabase -> Project Settings -> API: the project URL (https://<ref>.supabase.co)
# and the anon (publishable) key. Unset = that endpoint answers 503 and only
# booking-reference sign-in works.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""

# --- Service URLs ---------------------------------------------------------
# Where the agent service (port 8001) sends its tool calls.
FASTAPI_BASE_URL="http://127.0.0.1:8000"
# Exact browser origins allowed to call both services (Flutter web runs on
# 5173 via `flutter run -d chrome --web-port 5173`; the release build from
# `.\tasks.ps1 web` on 8080). The Android emulator and a phone are not
# browsers and need no entry here.
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:8080"

# --- Timing logs ------------------------------------------------------------
# Both services log one JSON line per request / chat turn to logs/
# (KESTREL_LOG_DIR moves it). LOG_TO_STDOUT=1 prints them instead - set in the
# container image (deploy/Dockerfile), where there is no disk to keep.
# KESTREL_LOG_DIR=""
# LOG_TO_STDOUT="1"
