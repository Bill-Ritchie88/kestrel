# Project Kestrel ignores.
#
# This file MUST stay UTF-8 with LF endings. A .gitignore saved as UTF-16 (the
# default when PowerShell's > redirection writes it on Windows) is unreadable
# to Git, which silently ignores nothing at all. That is how a .env containing
# live credentials was once committed. scripts/check_secrets.py enforces this.

# Secrets - never commit
.env
.env.*
!.env.example
*.pem
*.key
*.p12
credentials.json
service-account*.json

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Jupyter
.ipynb_checkpoints/

# Flutter / Dart (client tier)
.dart_tool/
.packages
*.iml

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Policy source texts (data/policy/sources/*.txt) are third-party documents:
# they are not redistributed in this repository. data/policy/sources/README.md
# says where each one comes from; MANIFEST.sha256 records the exact version
# ingested.
data/policy/sources/*.txt

# Local tooling and working files (not part of the project)
.claude/settings.local.json
.mcp.json
.sprint2-tmp/
# Source policy documents are not redistributed (see data/policy/sources/README.md)
/*.pdf
